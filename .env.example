# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle —
# they are visible to anyone who inspects the app. Never put secrets here.

# Human-readable environment name shown in Settings ("development" | "staging" | "production")
EXPO_PUBLIC_APP_ENV=development

# Base URL for your backend / API (no trailing slash)
EXPO_PUBLIC_API_URL=https://api.example.com

# Feature flags (string "true" / "false")
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Backend provider placeholders — fill in when you add a service layer.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
